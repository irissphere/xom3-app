{
  "$schema": "tokens-v1",
  "geometry": {
    "opacity": {
      "low": "0.03",
      "medium": "0.05",
      "high": "0.07"
    },
    "blur": {
      "soft": "2px",
      "medium": "4px",
      "deep": "6px"
    },
    "stroke": {
      "thin": "1px",
      "regular": "1.5px"
    },
    "color": {
      "lightMode": {
        "primary": "rgba(255, 255, 245, 0.05)",
        "accentAmber": "rgba(255, 191, 0, 0.02)",
        "accentCyan": "rgba(0, 255, 255, 0.02)"
      },
      "darkMode": {
        "primary": "rgba(200, 200, 200, 0.04)",
        "accentAmber": "rgba(255, 191, 0, 0.02)",
        "accentCyan": "rgba(0, 255, 255, 0.02)"
      }
    },
    "assets": {
      "goldenSpiral": "/geometry/golden-spiral.svg",
      "fibonacciCircles": "/geometry/fibonacci-circles.svg",
      "metatronGrid": "/geometry/metatron-grid.svg",
      "orbitalRings": "/geometry/orbital-rings.svg"
    },
    "placement": {
      "offsetTopRight": "top right",
      "offsetBottomLeft": "bottom left",
      "behindSidebar": "left center",
      "behindHeader": "top center"
    }
  }
}
