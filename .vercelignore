# Vercel Ignore File
# Files to exclude from deployment

# Development files
.env.local
.env.development
.env.test

# Testing
tests/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
playwright.config.ts
test-results/
playwright-report/

# Documentation (optional - remove if you want docs deployed)
*.md
!README.md

# Scripts
scripts/

# Local data
data/
*.json
!package.json
!package-lock.json
!tsconfig.json
!vercel.json
!content/*.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary
.next/
.cache/
tmp/
temp/
